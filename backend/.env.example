# Memory & concurrency tuning (defaults match render.yaml for 512 MB hosts)
WEB_CONCURRENCY=1
MALLOC_ARENA_MAX=2
MALLOC_TRIM_THRESHOLD_=131072
YTDLP_MAX_CONCURRENT=1
MEM_BUDGET=4
MEM_YTDLP_COST=3
MEM_SOFT_MB=360
MEM_HARD_MB=430
MAX_THREADS=10

# Optional: YouTube cookies for yt-dlp on hosted/datacenter IPs (leave blank locally)
YOUTUBE_COOKIES_PATH=
YOUTUBE_COOKIES=
YOUTUBE_COOKIES_BASE64=
